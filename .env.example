# Chuỗi kết nối MongoDB dùng cho app desktop — nhúng vào bản build, người dùng không đổi được trong app (docs/DEPLOY.md).
# Nên tạo một user Atlas riêng chỉ có quyền readWrite trên database UMLAB_DB.
UMLAB_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
UMLAB_DB=umlab

# Trang quản trị (npm run admin → http://127.0.0.1:5176). Cần ít nhất một trong hai:
#  - email tài khoản UMLab được vào trang quản trị (đăng nhập bằng mật khẩu của chính tài khoản đó), cách nhau dấu phẩy
UMLAB_ADMIN_EMAILS=
#  - hoặc mật khẩu quản trị dự phòng (đăng nhập với tên "admin")
UMLAB_ADMIN_PASSWORD=
# Tuỳ chọn: cổng (mặc định 5176); địa chỉ nghe (mặc định 127.0.0.1 — chỉ máy này, 0.0.0.0 để mở trong mạng LAN);
# khoá ký cookie phiên (mặc định sinh ngẫu nhiên mỗi lần chạy).
# UMLAB_ADMIN_PORT=5176
# UMLAB_ADMIN_HOST=127.0.0.1
# UMLAB_ADMIN_SECRET=
