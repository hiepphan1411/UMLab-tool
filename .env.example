# Chuỗi kết nối MongoDB dùng cho app desktop — nhúng vào bản build, người dùng không đổi được trong app (docs/DEPLOY.md).
# Nên tạo một user Atlas riêng chỉ có quyền readWrite trên database UMLAB_DB.
UMLAB_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
UMLAB_DB=umlab
